{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:id(\\d{12,15})",
      "destination": "/api/[id]?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "/",
      "statusCode": 302
    }
  ],
  "functions": {
    "api/guardar.js": {
      "maxDuration": 30
    },
    "api/[id].js": {
      "maxDuration": 10
    }
  }
}
